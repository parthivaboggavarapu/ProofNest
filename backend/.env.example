# =================================================================
# ProofNest Backend Environment Variables (Production & Development)
# =================================================================

# Server & Network
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:5000
APP_TIMEZONE=Asia/Kolkata

# Database Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@proofnestcluster.aiu5b6f.mongodb.net/proofnest?retryWrites=true&w=majority

# JWT Authentication
JWT_ACCESS_SECRET=your_super_strong_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_super_strong_jwt_refresh_secret_key_here
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Internal OCR Engine Configuration (local tesseract.js / pdf-parse)
OCR_ENGINE=internal

# OpenRouter LLM Configuration
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embeddings & Vector Search (Hugging Face / Open Source)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional Email Notifications (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM=ProofNest <noreply@proofnest.com>
