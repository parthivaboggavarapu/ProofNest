# ProofNest backend — copy to backend/.env
# Placeholder values only. Never commit real secrets.
# See docs/19-environment-configuration.md

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Standardized MongoDB Connection Variable: MONGO_URI
# MongoDB Atlas Cluster: ProofNestCluster
# Target Database: proofnest
# Format: mongodb+srv://<username>:<password>@<cluster-host>/proofnest?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@proofnestcluster.mongodb.net/proofnest?retryWrites=true&w=majority
# Local fallback (if running standalone offline):
# MONGO_URI=mongodb://127.0.0.1:27017/proofnest

# Session-Based Authentication (express-session + connect-mongo)
# Required environment variable (no hardcoded fallback allowed)
SESSION_SECRET=replace-with-a-very-long-secure-random-session-secret

# File storage adapter: local | s3_compatible
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_BASE_URL=

# Upload limits
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_MIME=application/pdf,image/jpeg,image/png,image/webp

# OCR adapter: none | tesseract | document_ai | textract
OCR_PROVIDER=none
OCR_API_KEY=
OCR_API_ENDPOINT=

# LLM adapter: none | openai_compatible | anthropic
LLM_PROVIDER=none
LLM_API_KEY=
LLM_API_ENDPOINT=
LLM_MODEL=

# Jobs
REMINDER_JOB_ENABLED=true
REMINDER_JOB_CRON=0 * * * *

# Optional email notifications (MVP defaults to in-app only)
NOTIFICATION_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
